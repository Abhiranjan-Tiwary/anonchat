PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/anonchat
JWT_SECRET=replace_with_a_super_long_random_string_minimum_64_chars
REDIS_URL=redis://localhost:6379
EMAIL_USER=supportanonchat@gmail.com
EMAIL_PASS=your_gmail_app_password
OTP_EXPIRE_MINUTES=10

VAPID_PUBLIC_KEY=your_web_push_public_key
VAPID_PRIVATE_KEY=your_web_push_private_key
VAPID_SUBJECT=mailto:supportanonchat@gmail.com

STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
TURN_URLS=turn:your-turn-server.example.com:3478,turns:your-turn-server.example.com:5349
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/social/google/callback

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:5173/api/auth/social/facebook/callback

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
